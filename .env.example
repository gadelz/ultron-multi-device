# ULTron Multi-Device Automation
# Multi-device voice-controlled automation with AI orchestration

# Gateway
ULTRON_API_KEY=changeme-secret-key
ULTRON_GATEWAY=http://localhost:8080

# Database
DATABASE_URL=sqlite:///./ultron.db

# LLM Provider (ollama or openai)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:latest

# Ollama (if using)
# OLLAMA_HOST=http://localhost:11434
